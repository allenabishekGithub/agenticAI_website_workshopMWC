	@media (prefers-reduced-motion: reduce) {
		:global(html[data-theme='light']) {
			scroll-behavior: auto;
		}
	}
</style>

<script>
	import { marked } from 'marked';
	import { renderSVG } from 'uqr';
	import { COMPETITIONS, type Fixture, formatEuros, MAX_TICKETS, ZONES } from '../../lib/directo/campnou/data.ts';
	import { readHints } from '../../lib/directo/campnou/hints.ts';
	import { createVoiceMode, type VoiceState } from '../../lib/directo/campnou/voice.ts';
	import { createLiveSession, type LiveSession } from '../../lib/directo/campnou/live.ts';
	import { conToken } from '../../lib/directo/token.ts';

	marked.setOptions({ gfm: true, breaks: true });

	type FieldParam = {
		name: string;
		description: string;
		type: string;
		required: boolean;
		options?: string[];
	};

	const fixtures: Fixture[] = JSON.parse(document.getElementById('fixtures-data')!.textContent!);
	const fixtureById = new Map(fixtures.map((f) => [f.id, f]));
	const zoneById = new Map(ZONES.map((z) => [z.id, z]));

	const form = document.getElementById('reservationForm') as HTMLFormElement;
	const formCard = document.getElementById('form-card') as HTMLDivElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
	const dialog = document.getElementById('booking-dialog') as HTMLDialogElement;
	const modalDetails = document.getElementById('modal-details') as HTMLParagraphElement;
	const closeDialogBtn = document.getElementById('close-dialog-btn') as HTMLButtonElement;

	const partido = document.getElementById('partido') as HTMLSelectElement;
	const zona = document.getElementById('zona') as HTMLSelectElement;
	const entradas = document.getElementById('num-entradas') as HTMLSelectElement;
	const nombre = document.getElementById('name') as HTMLInputElement;
	const email = document.getElementById('email') as HTMLInputElement;
	const telefono = document.getElementById('telefono') as HTMLInputElement;
	const socio = document.getElementById('socio') as HTMLInputElement;
	const socioHint = document.getElementById('socio-hint') as HTMLSpanElement;

	const $ = (id: string) => document.getElementById(id) as HTMLElement;
	const plural = (n: number) => `${n} ${n === 1 ? 'ticket' : 'tickets'}`;

	// ----- Plane, legend and summary: always reflect the form -----
	const mapZones = document.querySelectorAll<SVGElement>('.zone[data-zone]');
	const legendButtons = document.querySelectorAll<HTMLButtonElement>('#legend button[data-zone]');

	function pickZone(id: string) {
		zona.value = id;
		zona.dispatchEvent(new Event('change', { bubbles: true }));
	}

	for (const el of mapZones) {
		el.addEventListener('click', () => pickZone(el.dataset.zone!));
		el.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter' && e.key !== ' ') return;
			e.preventDefault();
			pickZone(el.dataset.zone!);
		});
	}
	for (const button of legendButtons) button.addEventListener('click', () => pickZone(button.dataset.zone!));

	function updateSummary() {
		const fixture = fixtureById.get(partido.value);
		const zone = zoneById.get(zona.value);
		const count = Number(entradas.value) || 0;

		for (const el of mapZones) el.dataset.selected = String(el.dataset.zone === zona.value);
		for (const button of legendButtons) button.setAttribute('aria-pressed', String(button.dataset.zone === zona.value));
		if (fixture) {
			for (const el of document.querySelectorAll<HTMLElement>('[data-price]')) {
				el.textContent = formatEuros(fixture.prices[el.dataset.price!]!);
			}
		}

		socioHint.textContent = zone?.membersOnly ? 'mandatory in Gol Sud' : 'optional';
		socioHint.classList.toggle('required', !!zone?.membersOnly);

		if (!fixture || !zone) return;
		const price = fixture.prices[zone.id]!;
		$('summary-match').textContent = `FC Barcelona – ${fixture.rival}`;
		$('summary-line').textContent = `${fixture.dateLabel} · ${fixture.time} · ${zone.name} · ${plural(count)} × ${formatEuros(price)}`;
		$('summary-total').textContent = formatEuros(price * count);
	}

	form.addEventListener('input', updateSummary);
	form.addEventListener('change', updateSummary);
	updateSummary();

	// Buy button of the calendar and the €250
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-buy]')) {
		button.addEventListener('click', () => {
			partido.value = button.dataset.buy!;
			partido.dispatchEvent(new Event('change', { bubbles: true }));
			document.getElementById('tickets')?.scrollIntoView({ behavior: 'smooth' });
		});
	}

	// ----- Derivate the tool from the HTML form -----
	const toolName = form.getAttribute('toolname') ?? '';
	const toolDescription = form.getAttribute('tooldescription') ?? '';

	function getParams(): FieldParam[] {
		const fields = form.querySelectorAll<HTMLElement>('[toolparamdescription]');
		return Array.from(fields).map((el) => {
			const field = el as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
			const isSelect = field.tagName === 'SELECT';
			return {
				name: field.getAttribute('name') ?? '',
				description: field.getAttribute('toolparamdescription') ?? '',
				type: isSelect ? 'enum' : ((field as HTMLInputElement).type ?? 'text'),
				required: field.hasAttribute('required'),
				options: isSelect ? Array.from((field as HTMLSelectElement).options).map((o) => o.value) : undefined,
			};
		});
	}

	const params = getParams();

	// ----- Support: the declarative API is not yet native -----
	const nav = navigator as any;
	const hasNative = typeof nav.modelContext?.registerTool === 'function';
	const supportBadge = document.getElementById('support-badge') as HTMLParagraphElement;
	if (hasNative) {
		supportBadge.textContent = 'navigator.modelContext nativo';
	} else {
		supportBadge.hidden = true;
	}

	// ----- JSON schema of the tool (for the model's "Pram-calling") -----
	function buildToolParameters() {
		const properties: Record<string, any> = {};
		const required: string[] = [];
		for (const p of params) {
			const prop: Record<string, any> = { type: 'string', description: p.description };
			if (p.options) prop.enum = p.options;
			properties[p.name] = prop;
			if (p.required) required.push(p.name);
		}
		return { type: 'object', properties, required };
	}

	const openAiTools = [
		{
			type: 'function',
			function: {
				name: toolName,
				description: toolDescription,
				parameters: buildToolParameters(),
			},
		},
	];

	// ----- Validation (returns MCP-style errors) -----
	type ValidationError = { field: string; value: string; message: string };

	function resetValidationUI() {
		form.querySelectorAll('.field-input').forEach((el) => el.classList.remove('invalid'));
		form.querySelectorAll('.error-msg').forEach((el) => el.classList.add('hidden'));
	}

	function validateForm(): ValidationError[] {
		const errors: ValidationError[] = [];

		const check = (field: HTMLInputElement | HTMLSelectElement, condition: boolean, message?: string) => {
			const errorSpan = field.closest('.field')?.querySelector('.error-msg') as HTMLElement | null;
			if (!condition) {
				if (errorSpan && message) errorSpan.textContent = message;
				field.classList.add('invalid');
				errorSpan?.classList.remove('hidden');
				errors.push({
					field: field.name,
					value: field.value,
					message: errorSpan?.textContent?.trim() ?? 'Invalid field',
				});
			} else {
				field.classList.remove('invalid');
				errorSpan?.classList.add('hidden');
			}
		};

		const fixture = fixtureById.get(partido.value);
		check(partido, !!fixture);

		const zone = zoneById.get(zona.value);
		check(zona, !!zone);

		const count = Number(entradas.value);
		const limit = Math.min(MAX_TICKETS, fixture?.maxTickets ?? MAX_TICKETS);
		check(
			entradas,
			Number.isInteger(count) && count >= 1 && count <= limit,
			limit < MAX_TICKETS && fixture?.tag
				? `For ${fixture.tag}maximum ${limit} Tickets per person.`
				: `You can book from 1 to ${MAX_TICKETS} tickets.`,
		);

		check(nombre, nombre.value.trim().split(/\s+/).filter((w) => w.length >= 2).length >= 2);

		check(email, /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim()));

		const phone = telefono.value.replace(/\D/g, '').replace(/^(0034|34)(?=\d{9}$)/, '');
		check(telefono, /^[6789]\d{8}$/.test(phone));

		const memberNumber = socio.value.trim();
		if (zone?.membersOnly && !memberNumber) {
			check(socio, false, "The South Goal supporters' stand (Gol Sud, Grada d'Animació) is for members only: provide your membership number.");
		} else {
			check(socio, memberNumber === '' || /^\d{5,8}$/.test(memberNumber), 'The membership number is between 5 and 8 digits.');
		}

		return errors;
	}

	// Seats and locator lie, but real-looking.
	function randomCode() {
		const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
		return Array.from(crypto.getRandomValues(new Uint8Array(6)), (n) => alphabet[n % alphabet.length]).join('');
	}

	const GATES: Record<string, number[]> = {
		tribuna: [14, 15, 16],
		lateral: [3, 4, 5],
		'gol-nord': [9, 10, 11],
		'gol-sud': [18, 19, 20],
		'palco-vip': [15],
	};

	function buildConfirmation(): string {
		const fixture = fixtureById.get(partido.value)!;
		const zone = zoneById.get(zona.value)!;
		const count = Number(entradas.value);
		const total = fixture.prices[zone.id]! * count;
		const rand = (min: number, max: number) => min + Math.floor(Math.random() * (max - min + 1));
		const gates = GATES[zone.id] ?? [1];

		const code = `CN-${randomCode()}`;
		const gate = gates[rand(0, gates.length - 1)]!;
		const sector = zone.id === 'palco-vip' ? 'VIP' : String(rand(101, 146));
		const row = String(rand(3, 28));
		const first = rand(1, 30);
		const seats = count === 1 ? String(first) : `${first}–${first + count - 1}`;

		$('ticket-code').textContent = `Localizador ${code}`;
		($('ticket-rival-crest') as HTMLImageElement).src = fixture.crest;
		$('ticket-comp').textContent = COMPETITIONS[fixture.competition] + (fixture.tag ? ` · ${fixture.tag}` : '');
		$('ticket-match').textContent = `FC Barcelona – ${fixture.rival}`;
		$('ticket-date').textContent = `${fixture.dateLong} · ${fixture.time} h`;
		$('ticket-zone').textContent = zone.name;
		$('ticket-gate').textContent = String(gate);
		$('ticket-sector').textContent = sector;
		$('ticket-row').textContent = row;
		$('ticket-seat').textContent = seats;
		$('ticket-total').textContent = formatEuros(total);
		$('ticket-qr').innerHTML = renderSVG(`${code}|${fixture.id}|${zone.id}|${count}`, {
			border: 0,
			blackColor: '#0c1b4d',
			whiteColor: '#ffffff',
		});
		modalDetails.textContent = `${plural(count)} in the name of ${nombre.value.trim()}We sent them to you. ${email.value.trim()}.`;

		return (
			`Reserva confirmada. Localizador ${code}. ${plural(count)} for FC Barcelona – ${fixture.rival} ` +
			`(${COMPETITIONS[fixture.competition]}), ${fixture.dateLong} at ${fixture.time}. ` +
			`${zone.name}, puerta ${gate}, sector ${sector}, fila ${row}, asientos ${seats}. ` +
			`Total ${formatEuros(total)}. Entradas enviadas a ${email.value.trim()}.`
		);
	}

	// ----- Sending handler of the form -----
	// In the native declarative API, the event takes e.agentInvoked and
	// e.respondWith(). Here we simulate it with an agent-context flag.
	let agentCall: { respondWith: (value: unknown) => void } | null = null;

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const errors = validateForm();
		const native = e as SubmitEvent & { agentInvoked?: boolean; respondWith?: (value: Promise<unknown>) => void };
		const respond =
			agentCall?.respondWith ??
			(native.agentInvoked && typeof native.respondWith === 'function'
				? (value: unknown) => native.respondWith!(Promise.resolve(value))
				: null);

		if (errors.length) {
			respond?.(errors);
			return;
		}

		const confirmation = buildConfirmation();
		dialog.showModal();
		respond?.(confirmation);
	});

	closeDialogBtn.addEventListener('click', () => dialog.close());
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});

	function applyFieldValue(name: string, value: string) {
		const field = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);
		if (!field) return;
		field.value = value;
		field.classList.add('tool-filling');
		field.dispatchEvent(new Event('input', { bubbles: true }));
		field.dispatchEvent(new Event('change', { bubbles: true }));
		setTimeout(() => field.classList.remove('tool-filling'), 700);
	}

	const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

	// ----- The agent executes the declarative tool -----
	// Fill in the actual field form and send it, capturing respondWith.
	async function runReservationTool(args: Record<string, any>): Promise<{ text: string; isError: boolean }> {
		resetValidationUI();
		formCard.classList.add('tool-active');
		formCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
		await wait(350);

		// The fields that the agent does not send are emptied: the tool is the source of truth.
		for (const p of params) {
			if (!(p.name in args) && !p.required && !p.options) applyFieldValue(p.name, '');
		}
		for (const [name, value] of Object.entries(args)) {
			applyFieldValue(name, String(value ?? ''));
			await wait(260);
		}

		submitBtn.classList.add('tool-submit-active');
		await wait(350);

		const result = await new Promise<unknown>((resolve) => {
			agentCall = { respondWith: resolve };
			form.requestSubmit();
		});
		agentCall = null;

		submitBtn.classList.remove('tool-submit-active');
		formCard.classList.remove('tool-active');

		const isError = Array.isArray(result);
		return {
			text: isError ? JSON.stringify(result) : String(result),
			isError,
		};
	}

	// ----- Asistente flotante -----
	const chatFab = document.getElementById('chat-fab') as HTMLButtonElement;
	const chatPanel = document.getElementById('chat-panel') as HTMLDivElement;
	const fabIconOpen = document.getElementById('fab-icon-open') as unknown as SVGElement;
	const fabIconClose = document.getElementById('fab-icon-close') as unknown as SVGElement;
	const chatLog = document.getElementById('chat-log') as HTMLDivElement;
	const chatForm = document.getElementById('chat-form') as HTMLFormElement;
	const chatInput = document.getElementById('chat-input') as HTMLTextAreaElement;
	const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
	const resetBtn = document.getElementById('reset-chat') as HTMLButtonElement;
	const agentStatus = document.getElementById('agent-status') as HTMLParagraphElement;
	const suggestionsEl = document.getElementById('suggestions') as HTMLDivElement;

	const now = new Date();
	const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
	const todayLabel = now.toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

	const fixturesForPrompt = fixtures
		.map(
			(f) =>
				`- ${f.id}: FC Barcelona vs ${f.rival} (${COMPETITIONS[f.competition]}${f.tag ? `, ${f.tag}` : ''}), ${f.dateLong} (${f.date}) to ${f.time}. ` +
				`Price per ticket: ${ZONES.map((z) => `${z.id} ${f.prices[z.id]} €`).join(', ')}.` +
				(f.maxTickets ? ` Maximum ${f.maxTickets} Tickets per person.` : '') +
				(f.status === 'ultimas' ? ' Quedan pocas entradas.' : ''),
		)
		.join('\n');

	const zonesForPrompt = ZONES.map((z) => `- ${z.id}: ${z.name} (${z.detail})`).join('\n');

	const SYSTEM_PROMPT =
		`You are the virtual ticket sales assistant for Spotify Camp Nou, the stadium of FC Barcelona (C. d'Arístides Maillol 12, Barcelona). ` +
		`Today is ${todayLabel} (${today}).\n\nPartidos for sale:\n${fixturesForPrompt}\n\nZonas:\n${zonesForPrompt}\n\n` +
		`Rules: 1 to ${MAX_TICKETS} tickets per purchase. The South Goal supporters' stand (Gol Sud, Grada d'Animació) is for members only and requires a membership number. ` +
		`Tickets are nominative: you need Spanish name, email and mobile.\n\n` +
		`To book, gather party, zone, number of tickets, first and last name, email and mobile, and use the tool "${toolName}" to fill in and send the page form. ` +
		`If you do not choose a zone, recommend one according to your budget and say the total. You understand "the Classic", "the Derbi", "the Champions" or "this Saturday" with the calendar above. ` +
		`If a data is missing, ask before calling the tool. If the tool returns errors, explain them and correct them with the user. ` +
		`When the reservation goes well, give the locator and summary in a few lines. ` +
		`Speak in English, of you, brief and friendly. Prices in euros.`;

	// In voice mode the answer is read out loud and the message comes transcribed by Whisper in local.
	const VOICE_PROMPT =
		`\n\nMODO VOZ: the user speaks to you and your answer will be read aloud. ` +
		`No memorydown, lists, tables, no emojis. ` +
		`Your message comes transcribed by Whisper and can bring errors: "REMABA" is @, "point" is ".," gathers the digits of your mobile phone ` +
		`and deduct the game or area even if they are miswritten. If an email or name is unclear, ask him to give it to you. ` +
		`Do not read out the entire booking summary: the form and ticket are already visible on screen; say only the booking reference and total.`;

	type ChatMessage = {
		role: 'system' | 'user' | 'assistant' | 'tool';
		content: string | null;
		tool_calls?: any[];
		tool_call_id?: string;
		name?: string;
	};
	let history: ChatMessage[] = [{ role: 'system', content: SYSTEM_PROMPT }];

	function scrollChat() {
		chatLog.scrollTop = chatLog.scrollHeight;
	}

	function escapeHtml(s: string) {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	}

	function addUserMessage(text: string) {
		const el = document.createElement('div');
		el.className = 'cn-row end';
		el.innerHTML = `<div class="cn-bubble user"></div>`;
		el.querySelector('div')!.textContent = text;
		chatLog.appendChild(el);
		scrollChat();
	}

	function addAssistantMessage(): HTMLDivElement {
		const el = document.createElement('div');
		el.className = 'cn-row';
		el.innerHTML = `<div class="cn-bubble agent"></div>`;
		chatLog.appendChild(el);
		scrollChat();
		return el.querySelector('div') as HTMLDivElement;
	}

	/** Visible waiting bubble while the model reasons. */
	let thinkingEl: HTMLElement | null = null;
	let thinkingTimer: ReturnType<typeof setInterval> | null = null;
	let thinkingStartedAt = 0;

	function showThinking(label = 'Thinking') {
		removeThinking();
		thinkingStartedAt = Date.now();
		const el = document.createElement('div');
		el.className = 'cn-row';
		el.setAttribute('aria-live', 'polite');
		el.setAttribute('aria-busy', 'true');
		el.innerHTML = `
			<div class="cn-thinking">
				<span class="cn-dots" aria-hidden="true"><i></i><i></i><i></i></span>
				<span class="thinking-label">${escapeHtml(label)}…</span>
				<span class="cn-elapsed">0s</span>
			</div>`;
		chatLog.appendChild(el);
		thinkingEl = el;
		scrollChat();

		thinkingTimer = setInterval(() => {
			if (!thinkingEl) return;
			const secs = Math.floor((Date.now() - thinkingStartedAt) / 1000);
			const elapsed = thinkingEl.querySelector('.cn-elapsed') as HTMLElement | null;
			if (elapsed) elapsed.textContent = `${secs}s`;
		}, 250);
	}

	function updateThinking(label: string) {
		if (!thinkingEl) {
			showThinking(label);
			return;
		}
		const labelEl = thinkingEl.querySelector('.thinking-label') as HTMLElement | null;
		if (labelEl) labelEl.textContent = `${label}…`;
		scrollChat();
	}

	function removeThinking() {
		if (thinkingTimer) {
			clearInterval(thinkingTimer);
			thinkingTimer = null;
		}
		thinkingEl?.remove();
		thinkingEl = null;
	}

	// Chip showing what tool the agent uses at every moment
	function addToolChip(name: string, args: Record<string, any>) {
		removeThinking();
		const el = document.createElement('div');
		el.className = 'cn-row';
		const argsStr = Object.keys(args).length ? escapeHtml(JSON.stringify(args, null, 2)) : '{}';
		el.innerHTML = `
			<div class="cn-chip">
				<div class="cn-chip-head"><span class="cn-chip-dot"></span>tools/call → <strong>${escapeHtml(name)}</strong></div>
				<pre>${argsStr}</pre>
				<div class="cn-chip-result">Filling out the form.</div>
			</div>`;
		chatLog.appendChild(el);
		scrollChat();
		return el;
	}

	function resolveChip(chip: HTMLElement, text: string, isError: boolean) {
		chip.querySelector('.cn-chip-dot')?.classList.add(isError ? 'fail' : 'done');
		const resultEl = chip.querySelector('.cn-chip-result') as HTMLElement;
		resultEl.classList.toggle('fail', isError);
		resultEl.textContent = `→ ${text}`;
		scrollChat();
	}

	function setStatus(text: string, isBusy = false) {
		agentStatus.dataset.busy = String(isBusy);
		agentStatus.textContent = text;
	}

	async function callModel(): Promise<ChatMessage> {
		const res = await fetch('/api/directo/webmcp-chat', {
			method: 'POST',
			headers: conToken({ 'Content-Type': 'application/json' }),
			body: JSON.stringify({
				messages: history,
				tools: openAiTools,
				model: 'gpt-6-luna',
				reasoning_effort: 'xhigh',
			}),
		});
		if (!res.ok) {
			let message = `HTTP ${res.status}`;
			try {
				const data = await res.json();
				if (data?.error) message = data.error;
			} catch {}
			throw new Error(message);
		}
		const data = await res.json();
		return data.message as ChatMessage;
	}

	let busy = false;

	/** Send a message to the agent and return the text of your response (to read it in voice mode). */
	async function sendMessage(text: string, { fromVoice = false } = {}): Promise<string> {
		if (busy || !text.trim()) return '';
		busy = true;
		let reply = '';
		sendBtn.disabled = true;
		voiceBtn.disabled = true;
		liveBtn.disabled = true;
		sendBtn.textContent = '…';
		chatInput.disabled = true;
		suggestionsEl.innerHTML = '';

		if (!fromVoice) addUserMessage(text);
		history[0] = { role: 'system', content: SYSTEM_PROMPT + (voiceOn ? VOICE_PROMPT : '') };
		history.push({ role: 'user', content: text });

		try {
			setStatus('Thinking…', true);
			showThinking('Thinking');

			for (let step = 0; step < 6; step++) {
				if (step > 0) {
					setStatus('Thinking…', true);
					showThinking('Thinking');
				}

				const assistant = await callModel();
				history.push(assistant);

				const toolCalls = assistant.tool_calls ?? [];
				if (toolCalls.length === 0) {
					removeThinking();
					const bubble = addAssistantMessage();
					bubble.innerHTML = marked.parse(assistant.content ?? '') as string;
					reply = bubble.innerText;
					scrollChat();
					break;
				}

				for (const call of toolCalls) {
					const name = call.function?.name as string;
					let args: Record<string, any> = {};
					try {
						args = JSON.parse(call.function?.arguments || '{}');
					} catch {}

					setStatus(`Using ${name}…`, true);
					updateThinking(`Using ${name}`);
					const chip = addToolChip(name, args);

					const result =
						name === toolName ? await runReservationTool(args) : { text: `Unknown tool: ${name}`, isError: true };

					resolveChip(chip, result.text, result.isError);

					history.push({
						role: 'tool',
						tool_call_id: call.id,
						name,
						content: result.text,
					});
				}
				updateThinking('Thinking');
				setStatus('Thinking…', true);
			}
		} catch (err: any) {
			removeThinking();
			const bubble = addAssistantMessage();
			bubble.classList.add('error');
			bubble.innerHTML = `Could not close temporary folder: %s<small>${escapeHtml(err?.message ?? String(err))}</small>`;
			reply = 'I couldn\'t complete the request.';
		} finally {
			removeThinking();
			busy = false;
			sendBtn.disabled = false;
			voiceBtn.disabled = false;
			liveBtn.disabled = false;
			sendBtn.textContent = 'Send';
			chatInput.disabled = false;
			setStatus('Online');
			if (!voiceOn) chatInput.focus();
		}
		return reply;
	}

	const SUGGESTIONS = [
		'I want to go to the Classic with my partner, what areas are there?',
		'What are the Champions games and how much do they cost?',
		'4 tickets for derbi in Gol Nord to Laia Puig, laia@correo.es, 6/00678',
	];

	function renderSuggestions() {
		suggestionsEl.innerHTML = SUGGESTIONS.map(
			(s) => `<button type="button" data-suggestion="${s.replace(/"/g, '&quot;')}" class="cn-suggest">${escapeHtml(s)}</button>`,
		).join('');
		suggestionsEl.querySelectorAll<HTMLButtonElement>('[data-suggestion]').forEach((btn) => {
			btn.addEventListener('click', () => {
				if (busy) return;
				sendMessage(btn.dataset.suggestion!);
			});
		});
	}

	function greet() {
		const bubble = addAssistantMessage();
		bubble.innerHTML = marked.parse(
			'Hello! I am the assistant to **Spotify Camp Nou**. Tell me what game you want to see, how many you are and where you want to sit, and I will leave you the tickets reserved.',
		) as string;
		if (!voiceOn) renderSuggestions();
	}

	function resetChat() {
		removeThinking();
		history = [{ role: 'system', content: SYSTEM_PROMPT }];
		chatLog.innerHTML = '';
		greet();
		setStatus('Online');
	}

	let chatOpen = false;
	function toggleChat(open?: boolean) {
		chatOpen = open ?? !chatOpen;
		chatPanel.classList.toggle('hidden', !chatOpen);
		fabIconOpen.classList.toggle('hidden', chatOpen);
		fabIconClose.classList.toggle('hidden', !chatOpen);
		chatFab.setAttribute('aria-label', chatOpen ? 'Close Virtual Wizard' : 'Open Virtual Wizard');
		if (chatOpen) {
			if (chatLog.childElementCount === 0) greet();
			setTimeout(() => chatInput.focus(), 50);
		}
	}

	chatFab.addEventListener('click', () => toggleChat());

	chatForm.addEventListener('submit', (e) => {
		e.preventDefault();
		const text = chatInput.value.trim();
		if (!text) return;
		chatInput.value = '';
		chatInput.style.height = 'auto';
		sendMessage(text);
	});

	chatInput.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey) {
			e.preventDefault();
			chatForm.requestSubmit();
		}
	});
	chatInput.addEventListener('input', () => {
		chatInput.style.height = 'auto';
		chatInput.style.height = Math.min(chatInput.scrollHeight, 112) + 'px';
	});

	resetBtn.addEventListener('click', resetChat);

	// ----- Voice Mode: Whisper in local (WebGPU) + same agent WebMCP -----
	const voiceBtn = document.getElementById('voice-btn') as HTMLButtonElement;
	const voiceBar = document.getElementById('voice-bar') as HTMLDivElement;
	const voiceOrb = document.getElementById('voice-orb') as HTMLButtonElement;
	const voiceExit = document.getElementById('voice-exit') as HTMLButtonElement;
	const voiceTitle = document.getElementById('voice-title') as HTMLParagraphElement;
	const voiceSub = document.getElementById('voice-sub') as HTMLParagraphElement;
	const voiceProgress = document.getElementById('voice-progress') as HTMLDivElement;
	const voiceProgressBar = voiceProgress.querySelector('i') as HTMLElement;

	let voiceOn = false;
	/** Bubbles that are written while you talk, with the clues underneath. */
	let live: { row: HTMLElement; bubble: HTMLElement; hints: HTMLElement; key: string } | null = null;

	const VOICE_COPY: Record<VoiceState, [string, string]> = {
		off: ['', ''],
		loading: ['Loading Whisper…', 'Whisper base · WebGPU · in your browser'],
		listening: ['Listening', 'Speak whenever you want · Whisper in local'],
		hearing: ['Escuchando…', 'Tap the mic to send now'],
		transcribing: ['Transcribiendo…', 'Final run of Whisper'],
		busy: ['Thinking…', 'GPT-6 Moon + WebMCP tool'],
		speaking: ['Hablando…', 'Touch to interrupt'],
	};

	function renderVoiceState(state: VoiceState) {
		voiceBar.dataset.state = state;
		const [title, sub] = VOICE_COPY[state];
		voiceTitle.textContent = title;
		voiceSub.textContent = sub;
		voiceProgress.hidden = state !== 'loading';
		voiceOrb.setAttribute('aria-label', state === 'hearing' ? 'Send now' : state === 'speaking' ? 'Interrupt' : 'Voice mode');
	}

	function clearZoneHints() {
		for (const el of mapZones) delete el.dataset.hint;
	}

	function renderHints(text: string) {
		if (!live) return;
		const { fixture, zone, count, total } = readHints(text, fixtures);
		const chips = [fixture && `${fixture.rival}${fixture.tag ? ` · ${fixture.tag}` : ''}`, zone?.name, count && plural(count)].filter(
			Boolean,
		) as string[];
		if (total) chips.push(`≈ ${formatEuros(total)}`);
		const key = chips.join('|');
		if (key === live.key) return;
		live.key = key;
		live.hints.innerHTML = chips
			.map((c, i) => `<span class="cn-hint${total && i === chips.length - 1 ? ' total' : ''}">${escapeHtml(c)}</span>`)
			.join('');
		for (const el of mapZones) el.dataset.hint = String(el.dataset.zone === zone?.id);
	}

	function showLive(text = '') {
		if (!live) {
			const row = document.createElement('div');
			row.className = 'cn-row end';
			row.innerHTML = `<div class="cn-voice"><div class="cn-bubble user live"></div><div class="cn-hints"></div></div>`;
			chatLog.appendChild(row);
			live = { row, bubble: row.querySelector('.cn-bubble')!, hints: row.querySelector('.cn-hints')!, key: '' };
		}
		live.bubble.textContent = text;
		renderHints(text);
		scrollChat();
	}

	function finalizeLive(text: string, ms: number) {
		showLive(text);
		const { row, bubble } = live!;
		bubble.classList.remove('live');
		const meta = document.createElement('span');
		meta.className = 'cn-meta';
		meta.textContent = `voz · Whisper local · ${ms} ms`;
		row.querySelector('.cn-voice')!.appendChild(meta);
		live = null;
	}

	function dropLive() {
		live?.row.remove();
		live = null;
		clearZoneHints();
	}

	const voice = createVoiceMode({
		onState: renderVoiceState,
		onProgress: (pct, label) => {
			if (voice.state !== 'loading') return;
			voiceTitle.textContent = pct == null ? `${label}…` : `${label} · ${pct} %`;
			voiceProgressBar.style.width = `${pct ?? 100}%`;
		},
		onLevel: (level) => voiceOrb.style.setProperty('--level', level.toFixed(3)),
		onSpeechStart: () => {
			dropLive();
			showLive();
		},
		onPartial: (text) => showLive(text),
		onDiscard: dropLive,
		onFinal: async (text, ms) => {
			finalizeLive(text, ms);
			const reply = await sendMessage(text, { fromVoice: true });
			clearZoneHints();
			if (voiceOn) await voice.speak(reply);
		},
		onError: (message) => {
			const bubble = addAssistantMessage();
			bubble.classList.add('error');
			bubble.innerHTML = `Whisper ha fallado.<small>${escapeHtml(message)}</small>`;
		},
	});

	async function enterVoice() {
		if (voiceOn || liveOn || busy) return;
		voiceOn = true;
		chatForm.hidden = true;
		suggestionsEl.innerHTML = '';
		voiceBar.hidden = false;
		voiceProgressBar.style.width = '0';
		renderVoiceState('loading');
		try {
			await voice.start();
		} catch (err: any) {
			exitVoice();
			const bubble = addAssistantMessage();
			bubble.classList.add('error');
			bubble.innerHTML = `Could not activate voice mode.<small>${escapeHtml(err?.message ?? String(err))}</small>`;
		}
	}

	function exitVoice() {
		if (!voiceOn) return;
		voiceOn = false;
		voice.stop();
		dropLive();
		voiceBar.hidden = true;
		chatForm.hidden = false;
		chatInput.focus();
	}

	function voiceAction() {
		if (voice.state === 'hearing') voice.commit();
		else if (voice.state === 'speaking') voice.interrupt();
	}

	voiceBtn.addEventListener('click', enterVoice);
	voiceExit.addEventListener('click', exitVoice);
	voiceOrb.addEventListener('click', voiceAction);
	// Space = tap the microphone (send now or interrupt), useful during a live presentation.
	document.addEventListener('keydown', (e) => {
		if (!voiceOn || e.code !== 'Space' || e.repeat) return;
		const target = e.target as HTMLElement;
		if (target.closest('input, textarea, select, button')) return;
		e.preventDefault();
		voiceAction();
	});
	chatFab.addEventListener('click', () => {
		if (!chatOpen) exitVoice();
	});
	resetBtn.addEventListener('click', () => {
		if (!voiceOn) return;
		dropLive();
		if (voice.state === 'speaking') voice.interrupt();
	});

	// ----- Live: GPT-Live speaks and gpt-6-moon uses the WebMCP tool in the meantime -----
	const liveBtn = document.getElementById('live-btn') as HTMLButtonElement;
	const liveStage = document.getElementById('live-stage') as HTMLDivElement;
	const liveTitle = document.getElementById('live-title') as HTMLParagraphElement;
	const liveSub = document.getElementById('live-sub') as HTMLParagraphElement;
	const liveControls = document.getElementById('live-controls') as HTMLDivElement;
	const liveMute = document.getElementById('live-mute') as HTMLButtonElement;
	const liveEnd = document.getElementById('live-end') as HTMLButtonElement;
	const panelBadge = document.getElementById('panel-badge') as HTMLSpanElement;

	// Voice prompt: conversation style and when to delegate (according to GPT-Live's guide).
	const LIVE_INSTRUCTIONS = `You are the ticket sales assistant for Spotify Camp Nou, the FC Barcelona stadium. You speak in English, from you, with warmth and a agile rhythm, like someone from the club’s box office. One or two short sentences per turn.

Backchannel Policy: Use few backchannels ("ahah", "okay") and don't step on the user.

Interruption policy: If the user interrupts you, stop talking and listen to him.

Delegation policy:
Backend Tools:
- Locker: know the matches for sale, the zones, prices and rules, and fill in and send the booking form on the page.

Genera <|SpawnThinking|> cuando:
- The user asks for matches, dates, prices, zones or rules.
- The user wants to book, or gives or corrects a booking data (party, zone, number of tickets, name, email, mobile or partner number).

Do not generate <|SpawnThinking|> when:
- Say hello, say goodbye or thank you.
- You need a brief clarification to understand what he's asking for.

Generates <|SpawnThinking|> before giving an answer that depends on the backend. Don't make up prices, dates, rules or locators while you wait: say something short and natural, like "okay, I look at it" or "I'll fill it out", and count the result when it arrives.
The user sees the form on screen while it is filled in: do not repeat all the data, say only what is important (the total, the locator or what is missing).

If a name, email or number is unclear, ask for it to be given by the "Screen" is @.
Keep listening if the user pauses to think. Don't treat coughs, music or background conversations as requests.`;

	const LIVE_GREETING =
		'Say hello now in Spanish from Spain: say you are the assistant to Spotify Camp Nou and ask what party you want to see. One sentence. Then stop and listen.';

	// Backend prompt: the usual business rules and how to return results to voice.
	const LIVE_BACKEND_NOTE =
		`\n\nTrabajas behind a voice assistant (GPT-Live): He talks to the user and passes you the conversation. ` +
		`Returns brief and concrete results to say them out loud, without remembering, lists or emojis. ` +
		`The conversation comes transcribed and can bring errors: "RENTBA" is @, "point" is ".," gathers the digits of the mobile ` +
		`and deduct the game or area even if they are miswritten. Use the tool as soon as you have the required data; if any is missing, say which one.`;

	const liveTools = [{ type: 'function', name: toolName, description: toolDescription, parameters: buildToolParameters() }];

	let liveOn = false;
	let liveSession: LiveSession | null = null;
	let userCaption = '';
	let userEndMs = 0;
	let agentCaption: { bubble: HTMLElement; text: string; endMs: number } | null = null;
	/** Pause from which the same speaker starts a new bubble. */
	const CAPTION_GAP = 1500;
	/** Margin to decide that one started talking when the other was done. */
	const TURN_GAP = 300;
	/** What was said during the call; when the call ends, it is added to the text chat history. */
	const liveTranscript: ChatMessage[] = [];
	let backendBusy = false;
	let toolRunning = false;
	let speakingUntil = 0;
	let hearingUntil = 0;
	let liveCopy = '';

	function closeUserCaption() {
		if (!live) return;
		live.bubble.classList.remove('live');
		if (userCaption.trim()) liveTranscript.push({ role: 'user', content: userCaption.trim() });
		live = null;
		userCaption = '';
	}

	function closeAgentCaption() {
		if (!agentCaption) return;
		agentCaption.bubble.classList.remove('speaking');
		if (agentCaption.text.trim()) liveTranscript.push({ role: 'assistant', content: agentCaption.text.trim() });
		agentCaption = null;
	}

	function renderLiveStage() {
		const now = performance.now();
		const connecting = liveSession?.state !== 'live';
		const state = connecting ? 'connecting' : now < speakingUntil ? 'speaking' : now < hearingUntil ? 'hearing' : 'listening';
		liveStage.dataset.state = state;
		liveStage.dataset.backend = String(backendBusy || toolRunning);

		const title = connecting
			? 'Connecting…'
			: liveSession?.muted
				? 'Microphone muted'
				: state === 'speaking'
					? 'Speaking'
					: state === 'hearing'
						? 'Listening…'
						: 'Listening';
		const sub = connecting
			? 'Opening session with GPT-Live'
			: toolRunning
				? 'Filling the form with WebMCP.'
				: backendBusy
					? 'gpt-6-moon is looking at the locker.'
					: state === 'speaking'
						? 'You can interrupt anytime.'
						: 'GPT-Live · gpt-6-luna + WebMCP';
		const copy = `${title}|${sub}`;
		if (copy === liveCopy) return;
		liveCopy = copy;
		liveTitle.textContent = title;
		liveSub.textContent = sub;
	}

	function onLiveLevels(user: number, agent: number) {
		liveStage.style.setProperty('--agent', agent.toFixed(3));
		liveStage.style.setProperty('--user', user.toFixed(3));
		const now = performance.now();
		if (agent > 0.12) speakingUntil = now + 350;
		if (user > 0.18) hearingUntil = now + 350;
		renderLiveStage();
	}

	async function enterLive() {
		if (liveOn || voiceOn || busy) return;
		liveOn = true;
		chatPanel.classList.add('live');
		panelBadge.textContent = 'GPT-Live';
		liveStage.hidden = false;
		liveControls.hidden = false;
		chatForm.hidden = true;
		suggestionsEl.innerHTML = '';
		liveMute.setAttribute('aria-pressed', 'false');
		liveMute.querySelector('span')!.textContent = 'Mute';
		userEndMs = 0;
		liveCopy = '';
		removeThinking();
		// Without conversation yet, the written greeting is over: GPT-Live greets aloud.
		if (!history.some((m) => m.role === 'user')) chatLog.innerHTML = '';
		scrollChat();

		liveSession = createLiveSession({
			instructions: LIVE_INSTRUCTIONS,
			backendInstructions: SYSTEM_PROMPT + LIVE_BACKEND_NOTE,
			greeting: LIVE_GREETING,
			tools: liveTools,
			onState: (state) => {
				setStatus(state === 'live' ? 'In a call' : state === 'connecting' ? 'Connecting…' : 'Online', state === 'connecting');
				renderLiveStage();
				if (state === 'closed' && liveOn) exitLive();
			},
			onLevels: onLiveLevels,
			// Full plexy: both can talk at once, so each has his bubble open
			// and is grouped by time (start_ms/end_ms), not by whom the last one spoke.
			onUserText: (delta, startMs, endMs) => {
				if (live && startMs - userEndMs > CAPTION_GAP) closeUserCaption();
				// The assistant was done when you started: his next sentence will go underneath.
				if (agentCaption && startMs > agentCaption.endMs + TURN_GAP) closeAgentCaption();
				userCaption += delta;
				userEndMs = endMs;
				showLive(userCaption.trim());
			},
			onAgentText: (delta, startMs, endMs) => {
				if (agentCaption && startMs - agentCaption.endMs > CAPTION_GAP) closeAgentCaption();
				if (live && startMs > userEndMs + TURN_GAP) closeUserCaption();
				if (!agentCaption) {
					const bubble = addAssistantMessage();
					bubble.classList.add('speaking');
					agentCaption = { bubble, text: '', endMs };
				}
				// Without the loose score with which a fragment is sometimes started (". Ready...").
				agentCaption.text = (agentCaption.text + delta).replace(/^[\s.,;:]+/, '');
				agentCaption.endMs = endMs;
				agentCaption.bubble.textContent = agentCaption.text;
				scrollChat();
			},
			onDelegation: () => {
				backendBusy = true;
				renderLiveStage();
			},
			onBackendDone: () => {
				backendBusy = false;
				renderLiveStage();
			},
			onToolCall: async ({ name, args }) => {
				closeUserCaption();
				closeAgentCaption();
				toolRunning = true;
				renderLiveStage();
				const chip = addToolChip(name, args as Record<string, any>);
				try {
					const result =
						name === toolName ? await runReservationTool(args as Record<string, any>) : { text: `Unknown tool: ${name}`, isError: true };
					resolveChip(chip, result.text, result.isError);
					return result.text;
				} finally {
					toolRunning = false;
					clearZoneHints();
					renderLiveStage();
				}
			},
			onError: (message) => {
				const bubble = addAssistantMessage();
				bubble.classList.add('error');
				bubble.innerHTML = `GPT-Live: ${escapeHtml(message)}`;
			},
		});

		try {
			await liveSession.start();
		} catch (err: any) {
			exitLive();
			const bubble = addAssistantMessage();
			bubble.classList.add('error');
			bubble.innerHTML = `Couldn't start the live conversation.<small>${escapeHtml(err?.message ?? String(err))}</small>`;
		}
	}

	function exitLive() {
		if (!liveOn) return;
		liveOn = false;
		liveSession?.stop();
		closeUserCaption();
		closeAgentCaption();
		// The text chat follows the conversation where she left the call.
		history.push(...liveTranscript.splice(0));
		backendBusy = false;
		toolRunning = false;
		clearZoneHints();
		chatPanel.classList.remove('live');
		panelBadge.textContent = 'WebMCP';
		liveStage.hidden = true;
		liveControls.hidden = true;
		chatForm.hidden = false;
		setStatus('Online');
		chatInput.focus();
	}

	liveBtn.addEventListener('click', enterLive);
	liveEnd.addEventListener('click', exitLive);
	liveMute.addEventListener('click', () => {
		if (!liveSession) return;
		const next = !liveSession.muted;
		liveSession.setMuted(next);
		liveMute.setAttribute('aria-pressed', String(next));
		liveMute.querySelector('span')!.textContent = next ? 'Enable microphone' : 'Mute';
		renderLiveStage();
	});
	chatFab.addEventListener('click', () => {
		if (!chatOpen) exitLive();
	});
	// GPT-Live charges per second: the session is closed when you leave the page.
	window.addEventListener('pagehide', () => liveSession?.stop());
</script>
