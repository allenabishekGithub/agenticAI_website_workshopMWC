---
import { Font } from 'astro:assets';
import { Code } from 'astro:components';
import PixelIcon from '../components/PixelIcon.astro';
import type { IconName } from '../components/pixel-icons';
import Slide from '../components/Slide.astro';
import { schedule } from '../data/agenda';
import { TOKEN_DEL_TALLER } from '../data/taller';
import '../styles/global.css';
import '../styles/slides.css';

const theme = 'css-variables';
const tokenSlide = TOKEN_DEL_TALLER || 'WORKSHOP_TOKEN missing in.dev.vars';

// The same icons as on the web cover
const blockIcons: IconName[] = ['mcp-ui', 'webmcp', 'jev', 'ia-local'];

const agendaIcon = (item: (typeof schedule)[number]): IconName => {
  if (item.block) return blockIcons[item.block - 1];
  if (item.kind === 'intro') return 'flag';
  if (item.kind === 'break') return 'coffee';
  return item === schedule.at(-1) ? 'ask' : 'cart';
};
const B1 = 'Section 1 · MCP UI';
const B2 = 'Section 2 · WebMCP';
const B3 = 'Section 3 · Jev';
const B4 = 'Section 4 · Local AI';

const mcpBasic = `server.registerTool(
  'ver_equipo',
  {
    description: 'Position, latest results and next match of a LaLiga team',
    inputSchema: z.object({
      equipo: z.string().describe('Name or nickname: "Barça", "Atleti".'),
    }),
  },
  async ({ equipo }) => {
    const ficha = await verEquipo(equipo); // JavaScript normal: call the API
    return {
      content: [{ type: 'text', text: resumen(ficha) }], // text for the model
    };
  },
);`;

const mcpServer = `registerAppTool(                 // before: Server.registerTool(
  server,
  'ver_equipo',
  {
    description: 'Position, latest results and next match of a LaLiga team',
    inputSchema: z.object({ equipo: z.string() }),
    _meta: { ui: { resourceUri: 'ui://laliga/vista.html' } },  // nuevo
  },
  async ({ equipo }) => {
    const ficha = await verEquipo(equipo);
    return {
      content: [{ type: 'text', text: resumen(ficha) }], // for the model
      structuredContent: { equipo: ficha },               // new: for the view
    };
  },
);`;

const mcpResource = `registerAppResource(
  server,
  'LaLiga',
  'ui://laliga/vista.html',
  {},
  async () => ({
    contents: [{
      uri: 'ui://laliga/vista.html',
      mimeType: RESOURCE_MIME_TYPE,   // text/html;profile=mcp-app
      text: await crearVista(),       // a unique HTML with its CSS and JS
      // The frame only carries what you allow: here, the shields
      _meta: { ui: { csp: { resourceDomains: ['https://a.espncdn.com'] } } },
    }],
  }),
);`;

const mcpView = `import { App } from '@modelcontextprotocol/ext-apps';
const app = new App({ name: 'LaLiga', version: '1.0.0' });

// client → view: the result of the tool arrives
app.addEventListener('toolresult', ({ structuredContent }) => {
  pintar(structuredContent); // the table, day or date
});

// view → server: click on a computer, without going through the model
$tabla.addEventListener('click', async (evento) => {
  const { equipo } = evento.target.closest('[data-equipo]').dataset;
  const resultado = await app.callServerTool({ name: 'ver_equipo', arguments: { equipo } });
  pintar(resultado.structuredContent);
});

await app.connect();`;

const webmcpTool = `await document.modelContext.registerTool({
  name: 'anadir_al_carrito',
  description: 'Add a product to your cart. Return your cart and the total in euros.',
  inputSchema: {
    type: 'object',
    properties: {
      id: { type: 'string', description: 'Product identifier' },
      cantidad: { type: 'integer', minimum: 1 },
    },
    required: ['id'],
  },
  execute({ id, cantidad = 1 }) {
    return añadirAlCarrito(id, cantidad);
  },
});`;

const webmcpForm = `<form
  toolname="suscribir_ofertas"
  tooldescription="Suscribe an email to the notices of offers in a category"
>
  <input type="email" name="email" required
         toolparamdescription="User e-mail" />

  <select name="categoria" required>…</select>

  <button>Notify me</button>
</form>`;

const webmcpHints = `annotations: {
  readOnlyHint:,, // read only, does not change anything
  untrustedContentHint: true, // returns third-party text (resistances)
  consequentialHint: true, // hard to undo: request confirmation
}`;

const jevRequest = `const respuesta = await fetch(\`\${API_URL}/api/jev\`, {
  method: 'POST',
  headers: { Authorization: \`Bearer \${TOKEN}\`, 'Content-Type': 'application/json' },
  body: JSON.stringify({
    State: { review: 'It was late and the box was broken. I never buy again.'},
    questions: {
      theme: {e.g.: '00}, "What is it about?",
                 criteria: { producto: null, envio: null, otro: null } },
      note: {number: score, }flashers: 'What do you think?',
                 criteria: ['Bad', 'Average', 'Good'] },
      urgent: {number: noul, }, }Was there an answer today? },
    },
  }),
});`;

const jevResponse = `{
  "answers": {
    "tema":    { "choice": "envio", "confidence": 0.97,
                 "probabilities": { "producto": 0.02, "envio": 0.97, "otro": 0.01 } },
    "nota":    { "score": 0.1, "confidence": 0.9 },
    "urgente": { "noul": 0.84 }
  },
  "usage": { "input_tokens": 212, "output_tokens": 30 }
}`;

const jevCode = `const { answers } = await respuesta.json();

if (answers.urgente.noul > 0.8) avisarAlEquipo();

if (answers.tema.choice === 'envio') abrirIncidencia('logística');

estrellas = Math.round(answers.nota.score) + 1;`;

const localSummarizer = `const idioma = { expectedInputLanguages: ['en'], outputLanguage: 'en' };

if ((await Summarizer.availability(idioma)) !== 'unavailable') {
  const summarizer = await Summarizer.create({
    ...idioma,
    type: 'tldr',
    length: 'short',
    monitor(m) {
      m.addEventListener('downloadprogress', (e) => console.log(e.loaded));
    },
  });

  const article = document.querySelector('article').innerText;
  let summary = '';

  for await (const trozo of summarizer.summarizeStreaming(article)) {
    summary += trozo;
  }

  console.log(summary);
}`;

const localPrompt = `const sesion = await LanguageModel.create({
  initialPrompts: [{ role: 'system', content: 'You\'re analyzing reviews of a store.' }],
});

const respuesta = await sesion.prompt('This product is a poop', {
  responseConstraint: {
    type: 'object',
    properties: {
      pros: { type: 'array', items: { type: 'string' } },
      contras: { type: 'array', items: { type: 'string' } },
    },
  },
});

const { pros, contras } = JSON.parse(respuesta);

console.log('Pros:', pros);
console.log('Contras:', contras);`;

const localWebgpu = `import { pipeline } from '@huggingface/transformers';

const generador = await pipeline(
  'text-generation',
  'onnx-community/Qwen3.5-0.8B-Text-ONNX',
  {
    device: navigator.gpu ? 'webgpu' : 'wasm',
    dtype: 'q4f16',                    // 470 MB that downloads user
    progress_callback: mostrarProgreso,
  },
);

const salida = await generador(mensajes, { max_new_tokens: 120 });`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* First in <head>: start the font preloads before anything else */}
    <Font cssVariable="--font-pixel" preload />
    <Font cssVariable="--font-mono" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Slides · Webs ready with AI</title>
  </head>
  <body>
    <main id="deck" class="deck" aria-live="polite">
      <!-- ─────────────── Apertura ─────────────── -->
      <Slide
        kind="image"
        src="/slides/portada.png"
        alt="Ups KILLING WEATER Barcelona. 15:00 – 18:00. Midudev. Webs is listed with the AI: MCP UI, WebMCP, Jev and local AI in the browser."
      />

      <Slide kind="statement">
        <div class="split">
          <div>
            <p class="big">Hola, soy <span class="accent">midudev</span></p>
            <p class="sub">Miguel Ángel Durán · Software developer and programmer</p>
          </div>
          <img class="avatar" src="/slides/midudev-pixel.png" alt="Portrait of the Middle-Side in Pachel art" width="64" height="64" />
        </div>
      </Slide>

      <Slide kind="statement">
        <p class="big">AI agents don't just talk anymore.</p>
        <p class="big"><span class="accent">Navegan</span>, usan <span class="accent">tools</span> and <span class="accent">act</span> on behalf of the user.</p>
        <div class="icon-row">
          <PixelIcon name="browser" size={128} />
          <PixelIcon name="tool" size={128} />
          <PixelIcon name="cursor" size={128} />
        </div>
      </Slide>

      <Slide kind="statement">
        <div class="split">
          <p class="big">
            Is your website<br />prepared for<br />a user who<br /><span class="accent">It's not a person.</span>?
          </p>
          <div class="not-human">
            <PixelIcon name="robot" size={384} class="hero blink" />
            {/* We turned the usual captcha around. */}
            <p class="captcha">
              <span class="tick"><PixelIcon name="check" size={48} /></span>
              I'm a robot.
            </p>
          </div>
        </div>
      </Slide>

      <Slide title="Today we built a store for agents.">
        <ol class="cards four">
          <li><div class="card-top"><span class="n">01</span><PixelIcon name="mcp-ui" size={80} /></div><h3>MCP UI</h3><p>The catalog, as an interface within the chat</p></li>
          <li><div class="card-top"><span class="n">02</span><PixelIcon name="webmcp" size={80} /></div><h3>WebMCP</h3><p>Web exposes tools to browser agents</p></li>
          <li><div class="card-top"><span class="n">03</span><PixelIcon name="jev" size={80} /></div><h3>Jev</h3><p>Quick decisions that code uses as it is</p></li>
          <li><div class="card-top"><span class="n">04</span><PixelIcon name="ia-local" size={80} /></div><h3>Local AI</h3><p>Models running in the browser</p></li>
        </ol>
        <p class="foot">Explanation → live code → guided challenge. So four times.</p>
      </Slide>

      <Slide title="Agenda">
        <ol class="agenda">
          {
            schedule.map((item) => (
              <li class={item.kind}>
                <PixelIcon name={agendaIcon(item)} size={48} />
                <span class="time">{item.start}</span>
                <span class="what">
                  {item.block && <span class="accent">{item.block} · </span>}
                  {item.title}
                </span>
                <span class="min">{item.minutes} min</span>
              </li>
            ))
          }
        </ol>
      </Slide>

      <Slide title="Before you start">
        <div class="split">
          <ol class="steps">
            <li><span class="n">1</span><div><h3>Clone the repository</h3><p><code>git clone https://github.com/midudev/upskilling-mwc-taller</code><br /><code>cd upskilling-mwc-taller</code></p></div></li>
            <li><span class="n">2</span><div><h3>Opens the workshop website</h3><p>Agenda, exercises and documentation of the APIs</p></div></li>
            <li><span class="n">3</span><div><h3>Note down the token</h3><p>One key for Jev and OpenAI. Caduca at the end.</p></div></li>
            <li><span class="n">4</span><div><h3>Check</h3><p>Chrome actualizado · Node.js 22+ · <code>node -v</code></p></div></li>
          </ol>
          <figure class="qr">
            <img src="/slides/qr-taller.svg" alt="QR code of the workshop repository" width="29" height="29" />
            <figcaption><code>midu.link/taller</code></figcaption>
          </figure>
        </div>
      </Slide>

      <Slide kind="statement" label="Workshop token">
        <p class="big token" style={`--chars: ${tokenSlide.length}`}>{tokenSlide}</p>
        <p class="sub">A single key for Jev and OpenAI. Stick it in <code>retos/config.js</code>It serves all exercises.</p>
      </Slide>

      <!-- ~ ~ ~ ~ Block 1 · MCP UI ~ ~ ~ ~ ~ ~ ~ Block 1 · MCP UI ~ -->
      <Slide kind="section" label="Block 1 · 15:10">
        <div class="split">
          <div>
            <p class="num">01</p>
            <h2>MCP UI</h2>
            <p class="sub">Interactive chats within the chat</p>
          </div>
          <PixelIcon name="mcp-ui" size={384} class="hero" />
        </div>
      </Slide>

      <Slide kind="statement" label={B1}>
        <p class="big">MCP: a common language between AI and <span class="accent">your code</span>.</p>
        <p class="sub">Model: An open standard: you write the server once and it works on Claude, ChatGPT, VS Code, Cursor.</p>
        <div class="icon-row">
          <PixelIcon name="chat" size={128} />
          <PixelIcon name="arrows" size={96} />
          <PixelIcon name="server" size={128} />
        </div>
      </Slide>

      <Slide label={B1} title="The pieces">
        <div class="flow chain">
          <div class="box"><PixelIcon name="chat" size={80} /><h3>Client</h3><p>Claude, ChatGPT, VS Code... with their model</p></div>
          <div class="arrow"><PixelIcon name="arrows" size={80} /><span>JSON-RPC</span></div>
          <div class="box hl"><PixelIcon name="server" size={80} /><h3>MCP server</h3><p>Your code</p></div>
          <div class="arrow"><PixelIcon name="arrows" size={80} /><span>fetch, SQL…</span></div>
          <div class="box"><PixelIcon name="cloud" size={80} /><h3>Your details</h3><p>APIs, database, files</p></div>
        </div>
        <p class="foot">In local (stdio) or remote (HTTP). The model never touches your API: only use what the server offers you.</p>
      </Slide>

      <Slide label={B1} title="What a server can offer">
        <ul class="cards three">
          <li><div class="card-top"><span class="n">decides the model</span><PixelIcon name="tool" size={80} /></div><h3>Tools</h3><p>Actions that the model executes when it needs them</p><p class="eg"><code>ver_equipo("Barça")</code></p></li>
          <li><div class="card-top"><span class="n">The app decides</span><PixelIcon name="doc" size={80} /></div><h3>Resources</h3><p>Data that the client reads and adds to the context</p><p class="eg"><code>ui://laliga/vista.html</code></p></li>
          <li><div class="card-top"><span class="n">decides the user</span><PixelIcon name="terminal" size={80} /></div><h3>Prompts</h3><p>Templates the user chooses, such as a command</p><p class="eg"><code>/resumen-jornada</code></p></li>
        </ul>
        <p class="foot">Today, especially in the case of the "Vulfur" and a very special resource: <span class="accent">ui://</span></p>
      </Slide>

      <Slide label={B1} title="What happens when you ask">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="doc" size={80} /><div><h3>Customer asks for tools</h3><p><code>tools/list</code>: name, description and outline of each</p></div></li>
          <li><span class="n">2</span><PixelIcon name="chat" size={80} /><div><h3>User asks</h3><p>«How was Barça in the last game?»</p></div></li>
          <li><span class="n">3</span><PixelIcon name="robot" size={80} class="blink" /><div><h3>The model chooses tool and arguments</h3><p><code>tools/call</code> → <code>ver_equipo({'{'} equipo: "Barça" {'}'})</code></p></div></li>
          <li><span class="n">4</span><PixelIcon name="server" size={80} /><div><h3>Your code responds</h3><p>The server calls the API and the model writes with the result</p></div></li>
        </ol>
        <p class="foot">The model decides only with the name and description.</p>
      </Slide>

      <Slide label={B1} title="A MCP Server: a tool">
        <Code code={mcpBasic} lang="js" theme={theme} />
      </Slide>

      <Slide label={B1} title="Live: LaLiga by MCP">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="tool" size={80} /><div><h3>Three tools</h3><p><code>ver_clasificacion</code> · <code>ver_resultados</code> · <code>ver_equipo</code></p></div></li>
          <li><span class="n">2</span><PixelIcon name="trophy" size={80} /><div><h3>Real data</h3><p>ESPN's public API, no key</p></div></li>
          <li><span class="n">3</span><PixelIcon name="chat" size={80} /><div><h3>We connected it to chat</h3><p>«How was Barça in the last game?»</p></div></li>
        </ol>
        <p class="foot"><a class="demo" href="http://localhost:3101" target="_blank" rel="noopener">Open the demo,</a>directo/liga/1-mcp · npm run dev</p>
      </Slide>

      <Slide kind="statement" label={B1}>
        <div class="split">
          <div>
            <p class="big">Problem: a tool only returns <span class="accent">text</span>.</p>
            <p class="sub">Twenty teams on a board of the gents, no shields, no colors, no touch.</p>
          </div>
          <PixelIcon name="doc" size={320} class="hero" />
        </div>
      </Slide>

      <Slide label={B1} title="MCP Apps: the tool brings its interface">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="doc" size={80} /><div><h3>The tool declares a view</h3><p><code>_meta.ui.resourceUri = "ui://laliga/vista.html"</code></p></div></li>
          <li><span class="n">2</span><PixelIcon name="robot" size={80} /><div><h3>The model calls the tool</h3><p>Text for model, view data</p></div></li>
          <li><span class="n">3</span><PixelIcon name="browser" size={80} /><div><h3>The client paints the HTML</h3><p>In an isolated frame, inside the conversation</p></div></li>
          <li><span class="n">4</span><PixelIcon name="arrows" size={80} /><div><h3>They talk both ways.</h3><p>View receives results and can call other tools</p></div></li>
        </ol>
      </Slide>

      <Slide label={B1} title="Server: a tool with interface">
        <Code code={mcpServer} lang="js" theme={theme} />
      </Slide>

      <Slide label={B1} title="Server: the resource <span class='accent'>ui://</span>">
        <Code code={mcpResource} lang="js" theme={theme} />
      </Slide>

      <Slide label={B1} title="View: the JavaScript of the inlay">
        <Code code={mcpView} lang="js" theme={theme} />
      </Slide>

      <Slide label={B1} title="Live: LaLiga with interface">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="tool" size={80} /><div><h3>The same tools</h3><p><code>registerAppTool</code> + <code>ui://laliga/vista.html</code></p></div></li>
          <li><span class="n">2</span><PixelIcon name="mcp-ui" size={80} /><div><h3>Data for the view</h3><p>Table, results and team sheet with shields</p></div></li>
          <li><span class="n">3</span><PixelIcon name="cursor" size={80} /><div><h3>View calls server</h3><p>Click on a computer → <code>ver_equipo</code>without going through the model</p></div></li>
        </ol>
        <p class="foot"><a class="demo" href="http://localhost:3102" target="_blank" rel="noopener">Open the demo,</a>directo/liga/2-mcp-ui · npm run dev</p>
      </Slide>

      <Slide kind="reto" label={B1}>
        <div class="split">
          <div>
            <p class="num">Exercise 1</p>
            <h2>The catalog inside the chat</h2>
            <ul>
              <li>Convert <code>buscar_productos</code> in an interface tool</li>
              <li>Register the appeal <code>ui://</code></li>
              <li>Have the Add button call the server</li>
            </ul>
            <p class="path">retos/01-mcp-ui/inicio · 18 min · <a href="http://localhost:3001" target="_blank" rel="noopener">localhost:3001</a></p>
          </div>
          <PixelIcon name="mcp-ui" size={320} class="hero" />
        </div>
      </Slide>

      <!-- ~ ~ ~ ~ ~ Block 2 · WebMCP ~ ~ ~ ~ ~ ~ ~ -->
      <Slide kind="section" label="Block 2 · 15:50">
        <div class="split">
          <div>
            <p class="num">02</p>
            <h2>WebMCP</h2>
            <p class="sub">Your website, as tools for browser agents</p>
          </div>
          <PixelIcon name="webmcp" size={384} class="hero" />
        </div>
      </Slide>

      <Slide label={B2} title="This is how your website uses an agent today">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="eye" size={80} /><div><h3>Makes a capture or reads the DOM</h3><p>Thousands of tokens for each step</p></div></li>
          <li><span class="n">2</span><PixelIcon name="question" size={80} /><div><h3>Guess which button to press</h3><p>"Will this icon be the cart?"</p></div></li>
          <li><span class="n">3</span><PixelIcon name="cursor" size={80} /><div><h3>Simulate a click and look again</h3><p>Slow, expensive and fragile</p></div></li>
        </ol>
        <p class="foot">You change a <code>div</code> And the agent gets lost.</p>
      </Slide>

      <Slide kind="statement" label={B2}>
        <p class="big">WebMCP: the web <span class="accent">tells him</span> What can you do?</p>
        <p class="sub">Your page records tools with <code>document.modelContext</code>The agent calls them: without reading the screen, without simulating clicks.</p>
        <div class="icon-row">
          <PixelIcon name="webmcp" size={128} />
          <PixelIcon name="arrows" size={96} />
          <PixelIcon name="robot" size={128} class="blink" />
        </div>
      </Slide>

      <Slide label={B2} title="MCP and WebMCP do not compete">
        <table class="two-lines">
          <thead><tr><th></th><th><span class="ico"><PixelIcon name="server" size={48} />MCP</span></th><th><span class="ico"><PixelIcon name="webmcp" size={48} />WebMCP</span></th></tr></thead>
          <tbody>
            <tr><td>Where it lives</td><td>On a server</td><td>On the page, in the browser</td></tr>
            <tr><td>Who uses it</td><td>Chat and IDE Assistants</td><td>Browser agents</td></tr>
            <tr><td>Session</td><td>You manage it (OAuth...)</td><td>The user: already logged in</td></tr>
            <tr><td>Interface</td><td>The chat (MCP Apps)</td><td>Your website, in the user's view</td></tr>
          </tbody>
        </table>
      </Slide>

      <Slide label={B2} title="Imperative API: <span class='accent'>registerTool</span>">
        <Code code={webmcpTool} lang="js" theme={theme} />
      </Slide>

      <Slide label={B2} title="API declarative: a form is a tool">
        <Code code={webmcpForm} lang="html" theme={theme} />
        <p class="foot">The agent fills in, the user confirms. <code>toolautosubmit</code> It's sent alone.</p>
      </Slide>

      <Slide label={B2} title="Tracks for agent and browser">
        <Code code={webmcpHints} lang="js" theme={theme} />
        <ul class="list">
          <li>Clear descriptions: what it does, what it returns and in what units</li>
          <li>Returns data, not HTML. Errors, as value</li>
          <li>Let the user see on screen what the agent does</li>
        </ul>
      </Slide>

      <Slide label={B2} title="Current state">
        <ul class="cards three">
          <li><PixelIcon name="key" size={80} /><h3>Origin trial</h3><p>In Chrome and Edge. It's not stable yet.</p></li>
          <li><PixelIcon name="flask" size={80} /><h3>Locally</h3><p><code>chrome://flags/</code><br /><code>#enable-webmcp-testing</code></p></li>
          <li><PixelIcon name="search" size={80} /><h3>To try it</h3><p>DevTools → Application → WebMCP</p></li>
        </ul>
        <p class="foot">It's a progressive improvement: if the browser doesn't have it, your website works the same way.</p>
      </Slide>

