    <footer class="hud" aria-hidden="true">
      <span id="clock"></span>
      <span id="section"></span>
      <span id="counter"></span>
    </footer>
    <div class="progress" aria-hidden="true"><div id="bar"></div></div>

    <script>
      const deck = document.querySelector<HTMLElement>('#deck')!;
      const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
      const counter = document.querySelector('#counter')!;
      const section = document.querySelector('#section')!;
      const clock = document.querySelector('#clock')!;
      const bar = document.querySelector<HTMLElement>('#bar')!;
      const hud = document.querySelector<HTMLElement>('.hud')!;

      let current = 0;

      function show(index: number) {
        current = Math.max(0, Math.min(slides.length - 1, index));
        slides.forEach((slide, i) => slide.classList.toggle('active', i === current));

        const slide = slides[current];
        counter.textContent = `${current + 1} / ${slides.length}`;
        section.textContent = slide.dataset.label ?? '';
        bar.style.width = `${((current + 1) / slides.length) * 100}%`;
        // Full screen images are shown clean
        hud.hidden = slide.classList.contains('image');
        history.replaceState(null, '', `#${current + 1}`);
      }

      // The stage measures always 1920×1080 and scales to the window
      function fit() {
        const scale = Math.min(innerWidth / 1920, innerHeight / 1080);
        deck.style.transform = `translate(-50%, -50%) scale(${scale})`;
      }

      function tick() {
        clock.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      }

      addEventListener('keydown', (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;

        switch (event.key) {
          case 'ArrowRight':
          case 'ArrowDown':
          case 'PageDown':
          case ' ':
          case 'Enter':
            event.preventDefault();
            show(current + 1);
            break;
          case 'ArrowLeft':
          case 'ArrowUp':
          case 'PageUp':
          case 'Backspace':
            event.preventDefault();
            show(current - 1);
            break;
          case 'Home':
            show(0);
            break;
          case 'End':
            show(slides.length - 1);
            break;
          case 'f':
            document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen();
            break;
        }
      });

      // Click on the right half: next. On the left: previous
      addEventListener('click', (event) => {
        if (getSelection()?.toString()) return;
        // The links to the demos open in another tab without going beyond slide
        if ((event.target as Element).closest('a')) return;
        show(current + (event.clientX > innerWidth / 2 ? 1 : -1));
      });

      // When entering, full screen. The browser only allows it after a gesture of the
      // user, so you order with the first key or click until you get it
      const gestures = ['pointerdown', 'keydown'] as const;

      function autoFullscreen(event?: Event) {
        // The f already alternates the full screen on its own
        if (event instanceof KeyboardEvent && event.key === 'f') return;
        if (document.fullscreenElement) return;
        document.documentElement.requestFullscreen().catch(() => {});
      }

      for (const gesture of gestures) addEventListener(gesture, autoFullscreen);
      // As soon as you enter (by whatever means) stop insisting: if you go out with Esc, it is respected
      addEventListener(
        'fullscreenchange',
        () => gestures.forEach((gesture) => removeEventListener(gesture, autoFullscreen)),
        { once: true },
      );
      autoFullscreen();

      addEventListener('resize', fit);
      addEventListener('hashchange', () => show(Number(location.hash.slice(1)) - 1 || 0));

      fit();
      tick();
      setInterval(tick, 10_000);
      show(Number(location.hash.slice(1)) - 1 || 0);
    </script>
