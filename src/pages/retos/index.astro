---
import { retos } from '../../data/retos';
import Base from '../../layouts/Base.astro';
---

<Base title="Exercises">
  <p class="label">One online store, four pieces</p>
  <h1>Exercises</h1>
  <p class="intro muted">
    Each challenge has a folder <code>inicio</code> (the starting point, with the <code>TODO</code> marked) and one
    carpeta <code>solucion</code>. The demo of each challenge has a tab <strong>View solution</strong> that executes it without
    If you miss it, copy the solution and continue with the next block.
  </p>

  <ol>
    {
      retos.map((reto) => (
        <li>
          <a href={`/retos/${reto.slug}`}>
            <span class="n">0{reto.bloque}</span>
            <div>
              <h2>{reto.title}</h2>
              <p class="muted">{reto.resumen}</p>
            </div>
            <span class="muted time">{reto.minutos} min</span>
          </a>
        </li>
      ))
    }
  </ol>

  <pre><code>exercises/
├── 01-mcp-ui/     inicio/  solucion/  README.md
├── 02-webmcp/     inicio/  solucion/  README.md
├── 03-jev/        inicio/  solucion/  README.md
└── 04-ia-local/   inicio/  solucion/  README.md   ← the solution is the complete app</code></pre>
</Base>

<style>
  h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin-block: 0.5rem 1.25rem;
  }

  .intro {
    max-width: 62ch;
    margin-bottom: 3rem;
  }

  ol {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
  }

  li a {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  li:last-child a {
    border-bottom: 1px solid var(--line);
  }

  li a:hover {
    color: var(--fg);
  }

  li a:hover h2 {
    color: var(--accent);
  }

  .n {
    font-family: var(--pixel);
    font-size: 1.25rem;
    color: var(--accent);
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 0.35rem;
  }

  .time {
    font-size: 0.8rem;
    white-space: nowrap;
  }
</style>
