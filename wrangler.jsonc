{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upskilling-mwc-taller",
  "account_id": "599228840df452ef6b4df93a2b67c0ee",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The secrets go with `wrangler secret put`.
  "vars": {
    // OpenAI models that attendees can use (the first is the default model)
    "OPENAI_MODELS": "gpt-6-luna",
    "JEV_DEFAULT_MODEL": "jev-latest"
  },

  // IP limit to the workshop APIs. The whole room is online by the same Wi-Fi (same IP),
  // So the limit is for the entire room, not per person: 300 requests every 10 s (~1.800/min,
  // Designed for more than 100 people, about 150 with margin). 10 s windows: if someone leaves a loop, the lock lasts little.
  // If you change `period`, update RATE_LIMIT_PERIOD in src/lib/proxy.ts.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 10 }
    }
  ]
}
